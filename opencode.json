{
  "$schema": "https://opencode.ai/config.json",
  "skills": {
    "paths": [".claude/skills"]
  },
  "instructions": ["AGENTS.md"],
  "permission": {
    "bash": {
      "*": "ask",
      "venv/Scripts/python.exe *": "allow",
      "./venv/Scripts/python.exe *": "allow",
      "venv/Scripts/pip.exe list*": "allow",
      "./venv/Scripts/pip.exe list*": "allow",
      "venv/Scripts/python.exe -m pytest*": "allow",
      "./venv/Scripts/python.exe -m pytest*": "allow",
      "venv/Scripts/python.exe -m ruff*": "allow",
      "./venv/Scripts/python.exe -m ruff*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "ls*": "allow",
      "cat*": "allow"
    },
    "webfetch": "ask",
    "websearch": "ask"
  },
  "compaction": {
    "auto": true
  }
}
